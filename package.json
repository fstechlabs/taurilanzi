{
  "name": "taurilanzi",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "nuxt build src-nuxt",
    "dev": "nuxt dev src-nuxt",
    "generate": "nuxt generate src-nuxt",
    "preview": "nuxt preview src-nuxt",
    "postinstall": "nuxt prepare src-nuxt && bun scripts/fetch-node.ts && (git config core.hooksPath .githooks || true)",
    "tauri": "tauri",
    "dev:no-dock": "TAURILANZI_NO_DOCK=1 tauri dev",
    "typecheck": "nuxi typecheck src-nuxt",
    "test": "bun test --preload ./tests/unit/setup.ts tests/unit",
    "e2e": "bun tests/e2e/run.ts",
    "screenshots": "bun tests/e2e/run.ts --release-name --spec screenshots/readme.e2e.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/vue": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "nuxt": "^4.6.2",
    "reka-ui": "^2.11.0",
    "shadcn-nuxt": "2.8.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
