    "@wdio/cli": "^9",
    "@wdio/globals": "^9",
    "@wdio/local-runner": "^9",
    "@wdio/mocha-framework": "^9",
    "@wdio/spec-reporter": "^9",
    "@wdio/tauri-plugin": "1.5.0",
    "@wdio/tauri-service": "^1.5.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vue-tsc": "^3.3.13",
    "webdriverio": "^9"
  }
